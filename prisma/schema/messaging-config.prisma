/// Singleton (id = "default"), managed by the Super Admin.
model MessagingConfig {
  id                 String   @id @default("default") @db.VarChar(50)
  /// Resend API key, AES-256-GCM encrypted with APP_ENCRYPTION_KEY.
  resendApiKeyCipher String   @db.Text
  fromEmail          String   @db.VarChar(255)
  fromName           String   @db.VarChar(255)
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  @@map("messaging_config")
}
